# Local development: files and DB on disk, real Gemini via your gcloud login (ADC)
APP_ENV=local
STORAGE=local
DB=local
AI=vertex
OCR=off
AUTH_MODE=dev
DATA_DIR=./data
GCP_PROJECT=social-pulse-510513
GEMINI_MODEL=gemini-2.5-flash
VERTEX_LOCATION=global
# GCP mode (set by `make deploy` on Cloud Run):
# STORAGE=gcs  BUCKET=social-pulse-510513-claimlens
# DB=firestore FIRESTORE_DB=claimlens
# OCR=docai    DOCAI_LOCATION=us DOCAI_PROCESSOR=<id>
# AUTH_MODE=firebase   (any Google account can sign in)
# JOBS=cloudtasks TASKS_QUEUE=claimlens-jobs TASKS_LOCATION=asia-south1
#   TASKS_SA=claimlens-tasks@<project>.iam.gserviceaccount.com SERVICE_URL=<cloud run url>
# Locally JOBS defaults to thread (analysis runs in a background thread).
